    given-names: Jeremiah
    orcid: "https://orcid.org/0009-0004-5620-996X"
    affiliation: "Department of Computer Science, Makerere University, Kampala, Uganda"
repository-code: "https://github.com/REPLACE-WITH-USERNAME/uganda-climate-intelligence"
